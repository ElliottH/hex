pkgname=hex-voice-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Hex: local voice dictation (Linux beta)'
arch=('x86_64')
url='https://github.com/anomalyco/hex'
license=('MIT')
depends=(
  'alsa-lib' 'curl' 'fontconfig' 'freetype2' 'gcc-libs' 'glib2' 'glibc'
  'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxkbcommon' 'libxkbcommon-x11'
  'libxrandr' 'openblas' 'openssl' 'systemd-libs' 'vulkan-icd-loader' 'wayland'
)
optdepends=(
  'wl-clipboard: paste on Wayland'
  'wtype: paste on Wayland'
  'vulkan-driver: GPU transcription'
)
provides=('hex-voice')
conflicts=('hex-voice')
options=('!strip' '!debug')
install=hex-voice-bin.install
source=(
