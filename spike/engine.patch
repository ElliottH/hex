+// Local research spike only. Model-owned immutable trie; per-decode cursor.
+#pragma once
+#include "transcribe-tokenizer.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <queue>
+#include <stdexcept>
+
+namespace transcribe::parakeet {
+struct PhraseBoost {
+    struct Node { std::map<int, int> edges; int failure = 0; };
+    std::vector<Node> nodes{1};
+    float bonus = 0, margin = 0;
+    size_t depth = 0;
+
+    void load(const Tokenizer & tokenizer) {
+        const char * path = std::getenv("HEX_BOOST_VOCABULARY");
+        if (!path) return;
+        const char * b = std::getenv("HEX_BOOST_BONUS");
+        const char * m = std::getenv("HEX_BOOST_MARGIN");
+        bonus = b ? std::stof(b) : 0;
+        margin = m ? std::stof(m) : 0;
+        if (!std::isfinite(bonus) || !std::isfinite(margin) || bonus < 0 || margin < 0 || bonus > 10 || margin > 10)
+            throw std::runtime_error("invalid phrase boost parameters");
+        std::ifstream input(path);
+        if (!input) throw std::runtime_error("cannot open boost vocabulary");
+        std::string term;
+        size_t count = 0;
+        while (std::getline(input, term)) {
+            if (term.empty()) continue;
+            if (++count > 64 || term.size() > 128) throw std::runtime_error("boost vocabulary too large");
+            std::vector<std::string> variants{term};
+            std::transform(term.begin(), term.end(), term.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+            variants.push_back(term);
+            term[0] = static_cast<char>(std::toupper(static_cast<unsigned char>(term[0])));
+            variants.push_back(term);
+            for (const auto & variant : variants) {
+                std::vector<int32_t> ids;
+                if (tokenizer.encode(variant, ids) != TRANSCRIBE_OK || ids.empty() || tokenizer.token(ids[0]).rfind("▁", 0) != 0)
+                    throw std::runtime_error("phrase has no word-boundary tokenization");
+                depth = std::max(depth, ids.size());
+                int node = 0;
+                for (int id : ids) {
+                    auto it = nodes[node].edges.find(id);
+                    if (it == nodes[node].edges.end()) {
+                        int next = static_cast<int>(nodes.size());
+                        nodes[node].edges[id] = next;
+                        nodes.push_back(Node{});
+                        node = next;
+                    } else node = it->second;
+                }
+            }
+        }
+        std::queue<int> queue;
+        for (auto [token, child] : nodes[0].edges) queue.push(child);
+        while (!queue.empty()) {
+            const int parent = queue.front(); queue.pop();
+            for (auto [token, child] : nodes[parent].edges) {
+                int f = nodes[parent].failure;
+                while (f && !nodes[f].edges.count(token)) f = nodes[f].failure;
+                auto it = nodes[f].edges.find(token);
+                nodes[child].failure = it == nodes[f].edges.end() ? 0 : it->second;
+                queue.push(child);
+            }
+        }
+    }
+
+    int advance(int node, int token) const {
+        while (node && !nodes[node].edges.count(token)) node = nodes[node].failure;
+        auto it = nodes[node].edges.find(token);
+        return it == nodes[node].edges.end() ? 0 : it->second;
+    }
+
+    int choose(const float * logits, int count, int blank, int & node) const {
+        int best = 0, second = -1;
+        for (int i = 1; i < count; ++i) {
+            if (logits[i] > logits[best]) { second = best; best = i; }
+            else if (second < 0 || logits[i] > logits[second]) second = i;
+        }
+        int chosen = best;
+        // Never turn blank into speech. Both top-two uncertainty and candidate
+        // acoustic distance must pass; confidence uses the ORIGINAL logits.
+        if (bonus > 0 && best != blank && second >= 0 && logits[best] - logits[second] <= margin) {
+            float score = logits[best];
+            int state = node;
+            do {
+                for (auto [token, child] : nodes[state].edges) {
+                    if (token >= count || token == blank) continue;
+                    if (logits[best] - logits[token] <= margin && logits[token] + bonus > score) {
+                        chosen = token;
+                        score = logits[token] + bonus;
+                    }
+                }
+                if (!state) break;
+                state = nodes[state].failure;
+            } while (true);
+        }
+        if (chosen != blank) node = advance(node, chosen);
+        return chosen;
+    }
+};
+}
