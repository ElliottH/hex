+            const size_t length = normalized.compare(i, k_sp_space_len, k_sp_space) == 0 ? k_sp_space_len : 1;
+            symbols.push_back(normalized.substr(i, length));
+            i += length;
+        }
+        for (;;) {
+            size_t best = symbols.size();
+            float score = -INFINITY;
+            for (size_t i = 0; i + 1 < symbols.size(); ++i) {
+                const int id = normal_id(symbols[i] + symbols[i + 1]);
+                if (id >= 0 && scores_[id] > score) { best = i; score = scores_[id]; }
+            }
+            if (best == symbols.size()) break;
+            symbols[best] += symbols[best + 1];
+            symbols.erase(symbols.begin() + static_cast<std::ptrdiff_t>(best + 1));
+        }
